      objectReference: {fileID: 0}
    - target: {fileID: 6226889290952283097, guid: ad9e39e63f8245e0b600864885c9eaf8, type: 3}
      propertyPath: m_Text
      value: "This roller coaster is also a road. It's set to not have the terrain
        conform to it, and to allow roll, something you usually don't want on a road.
        \n\nThe same basic workflow can be used on this coaster as on the roads.
        Unlike other road systems, MicroVerse uses a geometry deformation system,
        so can work with any type of mesh.\n"
      objectReference: {fileID: 0}
