      value: Text
      objectReference: {fileID: 0}
    - target: {fileID: 5185863668758595798, guid: ad9e39e63f8245e0b600864885c9eaf8, type: 3}
      propertyPath: m_Name
      value: Clearing
      objectReference: {fileID: 0}
    - target: {fileID: 6226889290952283097, guid: ad9e39e63f8245e0b600864885c9eaf8, type: 3}
      propertyPath: m_Text
      value: "Because this road is set to not affect the terrain, it won't clear
        trees. \n\nHowever, we can easily fix this - because it's a spline, we can
        add a SplineArea component to it and give it a width. Then add a clear or
        occlusion stamp with it's falloff set to SplineArea. In this example, we
        clear the trees, but leave the details growing under the bridge.\n\n"
      objectReference: {fileID: 0}
