    - target: {fileID: 4637274148725643058, guid: ad9e39e63f8245e0b600864885c9eaf8, type: 3}
      propertyPath: m_Name
      value: Text
      objectReference: {fileID: 0}
    - target: {fileID: 5185863668758595798, guid: ad9e39e63f8245e0b600864885c9eaf8, type: 3}
      propertyPath: m_Name
      value: Materials
      objectReference: {fileID: 0}
    - target: {fileID: 6226889290952283097, guid: ad9e39e63f8245e0b600864885c9eaf8, type: 3}
      propertyPath: m_Text
      value: "MicroVerse roads has a special shader, which uses a single texture
        for each road. This texture can describe the types of lines that appear on
        the road, as well as the types of cracking or wear along the road surface.
        For instance, this road has cracks and wear going along the road from years
        of tires going over it.  \n\nThe shader also supports weather conditions,
        such as wetness, puddles, and snow, which are compatibel with weather systems
        via the same technique MicroSplat and Better Lit Shader use. \n"
      objectReference: {fileID: 0}
